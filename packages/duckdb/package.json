{
	"name": "@datastream/duckdb",
	"version": "0.8.0",
	"description": "DuckDB writable streams (copy-from) for Node and browser",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./index.node.mjs",
	"module": "./index.browser.mjs",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"browser": "./index.browser.mjs",
			"node": "./index.node.mjs",
			"default": "./index.browser.mjs"
		},
		"./browser": {
			"types": "./index.d.ts",
			"default": "./index.browser.mjs"
		}
	},
	"types": "index.d.ts",
	"files": [
		"*.mjs",
		"*.map",
		"*.d.ts",
		"shared.js"
	],
	"scripts": {
		"test": "npm run test:unit",
		"test:unit": "node --test",
		"test:bench": "node --experimental-bench --bench 'index.bench.js'"
	},
	"license": "MIT",
	"keywords": [
		"duckdb",
		"sql",
		"writable",
		"Web Stream API",
		"Node Stream API"
	],
	"author": {
		"name": "datastream contributors",
		"url": "https://github.com/willfarrell/datastream/graphs/contributors"
	},
	"repository": {
		"type": "git",
		"url": "github:willfarrell/datastream",
		"directory": "packages/duckdb"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/datastream/issues"
	},
	"homepage": "https://datastream.js.org",
	"dependencies": {
		"@datastream/core": "0.8.0"
	},
	"peerDependencies": {
		"@duckdb/duckdb-wasm": ">=1.33.1-dev57.0 <2",
		"@duckdb/node-api": ">=1.5.4-r.1 <1.5.5 || >=1.5.5-r.1 <2",
		"apache-arrow": "^21.1.0"
	},
	"peerDependenciesMeta": {
		"@duckdb/duckdb-wasm": {
			"optional": true
		},
		"@duckdb/node-api": {
			"optional": true
		},
		"apache-arrow": {
			"optional": true
		}
	},
	"devDependencies": {
		"@datastream/arrow": "0.8.0",
		"@duckdb/duckdb-wasm": "1.33.1-dev57.0",
		"@duckdb/node-api": "1.5.6-r.1",
		"apache-arrow": "21.2.0"
	}
}
