{
	"name": "@datastream/charset",
	"version": "0.8.0",
	"description": "Character encoding detection, decoding, and conversion streams",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./index.node.mjs",
	"module": "./index.browser.mjs",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"browser": "./index.browser.mjs",
			"node": "./index.node.mjs",
			"default": "./index.browser.mjs"
		},
		"./browser": {
			"types": "./index.d.ts",
			"default": "./index.browser.mjs"
		},
		"./detect": {
			"types": "./detect.d.ts",
			"browser": "./detect.browser.mjs",
			"node": "./detect.node.mjs",
			"default": "./detect.browser.mjs"
		},
		"./detect/browser": {
			"types": "./detect.d.ts",
			"default": "./detect.browser.mjs"
		},
		"./decode": {
			"types": "./decode.d.ts",
			"browser": "./decode.browser.mjs",
			"node": "./decode.node.mjs",
			"default": "./decode.browser.mjs"
		},
		"./decode/browser": {
			"types": "./decode.d.ts",
			"default": "./decode.browser.mjs"
		},
		"./encode": {
			"types": "./encode.d.ts",
			"browser": "./encode.browser.mjs",
			"node": "./encode.node.mjs",
			"default": "./encode.browser.mjs"
		},
		"./encode/browser": {
			"types": "./encode.d.ts",
			"default": "./encode.browser.mjs"
		}
	},
	"types": "index.d.ts",
	"files": [
		"*.mjs",
		"*.map",
		"*.d.ts"
	],
	"scripts": {
		"test": "npm run test:unit",
		"test:unit": "node --test",
		"test:bench": "node --experimental-bench --bench 'index.bench.js'"
	},
	"license": "MIT",
	"keywords": [
		"Web Stream API",
		"Node Stream API"
	],
	"author": {
		"name": "datastream contributors",
		"url": "https://github.com/willfarrell/datastream/graphs/contributors"
	},
	"repository": {
		"type": "git",
		"url": "github:willfarrell/datastream",
		"directory": "packages/charset"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/datastream/issues"
	},
	"homepage": "https://datastream.js.org",
	"dependencies": {
		"@datastream/core": "0.8.0",
		"chardet": "2.2.0",
		"iconv-lite": "0.7.3"
	}
}
