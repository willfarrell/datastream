{
	"name": "@datastream/indexeddb",
	"version": "0.7.1",
	"description": "IndexedDB readable and writable streams for browser storage",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public"
	},
	"module": "./index.browser.mjs",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"browser": "./index.browser.mjs"
		},
		"./browser": {
			"types": "./index.d.ts",
			"default": "./index.browser.mjs"
		}
	},
	"types": "index.d.ts",
	"files": [
		"*.browser.mjs",
		"*.browser.mjs.map",
		"*.d.ts"
	],
	"scripts": {
		"test": "npm run test:unit",
		"test:unit": "node --test",
		"test:bench": "node --experimental-bench --bench 'index.bench.js'"
	},
	"license": "MIT",
	"keywords": [
		"Web Stream API"
	],
	"author": {
		"name": "datastream contributors",
		"url": "https://github.com/willfarrell/datastream/graphs/contributors"
	},
	"repository": {
		"type": "git",
		"url": "github:willfarrell/datastream",
		"directory": "packages/indexeddb"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/datastream/issues"
	},
	"homepage": "https://datastream.js.org",
	"dependencies": {
		"@datastream/core": "0.7.1",
		"idb": "8.0.3"
	}
}
