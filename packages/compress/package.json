{
	"name": "@datastream/compress",
	"version": "0.8.0",
	"description": "Compression and decompression streams for gzip, deflate, brotli, and zstd",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./index.node.mjs",
	"module": "./index.browser.mjs",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"browser": "./index.browser.mjs",
			"node": "./index.node.mjs",
			"default": "./index.browser.mjs"
		},
		"./browser": {
			"types": "./index.d.ts",
			"default": "./index.browser.mjs"
		},
		"./zstd": {
			"types": "./zstd.d.ts",
			"node": "./zstd.node.mjs",
			"default": "./zstd.node.mjs"
		},
		"./brotli": {
			"types": "./brotli.d.ts",
			"browser": "./brotli.browser.mjs",
			"node": "./brotli.node.mjs",
			"default": "./brotli.browser.mjs"
		},
		"./brotli/browser": {
			"types": "./brotli.d.ts",
			"default": "./brotli.browser.mjs"
		},
		"./gzip": {
			"types": "./gzip.d.ts",
			"browser": "./gzip.browser.mjs",
			"node": "./gzip.node.mjs",
			"default": "./gzip.browser.mjs"
		},
		"./gzip/browser": {
			"types": "./gzip.d.ts",
			"default": "./gzip.browser.mjs"
		},
		"./deflate": {
			"types": "./deflate.d.ts",
			"browser": "./deflate.browser.mjs",
			"node": "./deflate.node.mjs",
			"default": "./deflate.browser.mjs"
		},
		"./deflate/browser": {
			"types": "./deflate.d.ts",
			"default": "./deflate.browser.mjs"
		}
	},
	"types": "index.d.ts",
	"files": [
		"*.mjs",
		"*.map",
		"*.d.ts",
		"guard.node.js",
		"native.browser.js"
	],
	"scripts": {
		"test": "npm run test:unit",
		"test:unit": "node --test",
		"test:bench": "node --experimental-bench --bench 'index.bench.js'"
	},
	"license": "MIT",
	"keywords": [
		"Web Stream API",
		"Node Stream API"
	],
	"author": {
		"name": "datastream contributors",
		"url": "https://github.com/willfarrell/datastream/graphs/contributors"
	},
	"repository": {
		"type": "git",
		"url": "github:willfarrell/datastream",
		"directory": "packages/compress"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/datastream/issues"
	},
	"homepage": "https://datastream.js.org",
	"dependencies": {
		"@datastream/core": "0.8.0"
	},
	"devDependencies": {
		"brotli-wasm": "^3.0.0"
	},
	"peerDependencies": {
		"brotli-wasm": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"brotli-wasm": {
			"optional": true
		}
	}
}
