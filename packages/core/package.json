{
	"name": "@datastream/core",
	"version": "0.9.1",
	"description": "Stream creation utilities and pipeline functions for Web Streams API and Node.js streams",
	"type": "module",
	"sideEffects": false,
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./index.node.mjs",
	"module": "./index.browser.mjs",
	"exports": {
		".": {
			"browser": {
				"types": "./index.browser.d.ts",
				"default": "./index.browser.mjs"
			},
			"node": {
				"types": "./index.d.ts",
				"default": "./index.node.mjs"
			},
			"default": {
				"types": "./index.browser.d.ts",
				"default": "./index.browser.mjs"
			}
		},
		"./browser": {
			"types": "./index.browser.d.ts",
			"default": "./index.browser.mjs"
		}
	},
	"types": "index.d.ts",
	"files": [
		"*.mjs",
		"*.map",
		"*.d.ts",
		"helpers.js"
	],
	"scripts": {
		"test": "npm run test:unit",
		"test:unit": "node --test",
		"test:bench": "node --experimental-bench --bench 'index.bench.js'"
	},
	"license": "MIT",
	"keywords": [
		"Web Stream API",
		"Node Stream API"
	],
	"author": {
		"name": "datastream contributors",
		"url": "https://github.com/willfarrell/datastream/graphs/contributors"
	},
	"repository": {
		"type": "git",
		"url": "github:willfarrell/datastream",
		"directory": "packages/core"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/datastream/issues"
	},
	"homepage": "https://datastream.js.org",
	"dependencies": {},
	"devDependencies": {
		"@datastream/object": "0.9.1"
	}
}
