{
	"name": "@datastream/object",
	"version": "0.7.1",
	"description": "Object transform streams for picking, omitting, pivoting, batching, and key mapping",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./index.node.mjs",
	"module": "./index.browser.mjs",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"browser": "./index.browser.mjs",
			"node": "./index.node.mjs",
			"default": "./index.browser.mjs"
		},
		"./browser": {
			"types": "./index.d.ts",
			"default": "./index.browser.mjs"
		}
	},
	"imports": {
		"#deepEqual": {
			"browser": "./deepEqual.browser.js",
			"node": "./deepEqual.node.js",
			"default": "./deepEqual.browser.js"
		}
	},
	"types": "index.d.ts",
	"files": [
		"*.mjs",
		"*.map",
		"*.d.ts",
		"helpers.js",
		"deepEqual.browser.js",
		"deepEqual.node.js"
	],
	"scripts": {
		"test": "npm run test:unit",
		"test:unit": "node --test",
		"test:bench": "node --experimental-bench --bench 'index.bench.js'"
	},
	"license": "MIT",
	"keywords": [
		"Web Stream API",
		"Node Stream API"
	],
	"author": {
		"name": "datastream contributors",
		"url": "https://github.com/willfarrell/datastream/graphs/contributors"
	},
	"repository": {
		"type": "git",
		"url": "github:willfarrell/datastream",
		"directory": "packages/object"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/datastream/issues"
	},
	"homepage": "https://datastream.js.org",
	"dependencies": {
		"@datastream/core": "0.7.1"
	}
}
