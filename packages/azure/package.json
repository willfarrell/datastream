{
	"name": "@datastream/azure",
	"version": "0.8.0",
	"description": "Azure service streaming integrations for Blob Storage, Queue Storage, Service Bus, Event Hubs, and Cosmos DB",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public"
	},
	"main": "./index.node.mjs",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"node": "./index.node.mjs",
			"default": "./index.node.mjs"
		},
		"./blob": {
			"types": "./blob.d.ts",
			"node": "./blob.node.mjs",
			"default": "./blob.node.mjs"
		},
		"./queue": {
			"types": "./queue.d.ts",
			"node": "./queue.node.mjs",
			"default": "./queue.node.mjs"
		},
		"./service-bus": {
			"types": "./service-bus.d.ts",
			"node": "./service-bus.node.mjs",
			"default": "./service-bus.node.mjs"
		},
		"./event-hubs": {
			"types": "./event-hubs.d.ts",
			"node": "./event-hubs.node.mjs",
			"default": "./event-hubs.node.mjs"
		},
		"./event-hubs-kafka": {
			"types": "./event-hubs-kafka.d.ts",
			"node": "./event-hubs-kafka.node.mjs",
			"default": "./event-hubs-kafka.node.mjs"
		},
		"./cosmos": {
			"types": "./cosmos.d.ts",
			"node": "./cosmos.node.mjs",
			"default": "./cosmos.node.mjs"
		}
	},
	"types": "index.d.ts",
	"files": [
		"*.node.mjs",
		"*.node.mjs.map",
		"*.d.ts",
		"client.js"
	],
	"scripts": {
		"test": "npm run test:unit",
		"test:unit": "node --test"
	},
	"license": "MIT",
	"keywords": [
		"Azure",
		"Blob Storage",
		"Queue Storage",
		"Service Bus",
		"Event Hubs",
		"Cosmos DB",
		"Kafka",
		"Node Stream API"
	],
	"author": {
		"name": "datastream contributors",
		"url": "https://github.com/willfarrell/datastream/graphs/contributors"
	},
	"repository": {
		"type": "git",
		"url": "github:willfarrell/datastream",
		"directory": "packages/azure"
	},
	"bugs": {
		"url": "https://github.com/willfarrell/datastream/issues"
	},
	"homepage": "https://datastream.js.org",
	"dependencies": {
		"@datastream/core": "0.8.0"
	},
	"peerDependencies": {
		"@azure/cosmos": "^4.0.0",
		"@azure/event-hubs": "^6.0.0",
		"@azure/service-bus": "^7.0.0",
		"@azure/storage-blob": "^12.0.0",
		"@azure/storage-queue": "^12.0.0"
	},
	"peerDependenciesMeta": {
		"@azure/cosmos": {
			"optional": true
		},
		"@azure/event-hubs": {
			"optional": true
		},
		"@azure/service-bus": {
			"optional": true
		},
		"@azure/storage-blob": {
			"optional": true
		},
		"@azure/storage-queue": {
			"optional": true
		}
	},
	"devDependencies": {
		"@azure/cosmos": "^4.0.0",
		"@azure/event-hubs": "^6.0.0",
		"@azure/service-bus": "^7.0.0",
		"@azure/storage-blob": "^12.0.0",
		"@azure/storage-queue": "^12.0.0"
	}
}
