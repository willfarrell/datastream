{
	"license": ".license.template",
	"licenseFormats": {
		"js|ts": {
			"eachLine": {
				"prepend": "// "
			}
		}
	},
	"ignoreFile": ".gitignore",
	"ignore": [
		".claude/**/*",
		".github/**/*",
		".husky/**/*",
		"bin/*",
		"commitlint.config.cjs",
		"stryker*.config.*",
		"LICENSE",
		".license.template",
		".gitleaks.toml",
		".nvmrc",
		"**/.gitignore",
		"**/.npmrc",
		"**/*.fuzz.js",
		"**/*.bench.js",
		"**/*.test.js",
		"**/*.tst.ts",
		"**/*.md",
		"**/*.yml",
		"**/*.yaml",
		"websites/**/*",
		".DS_Store"
	]
}
